# soundspy environment configuration
# Copy this file to .env and fill in your values

# WiFi Configuration
WIFI_SSID=your_wifi_ssid_here
WIFI_PASSWORD=your_wifi_password_here

# MQTT Broker (use your server's IP address)
MQTT_HOST=192.168.1.100
MQTT_PORT=1883

# WebSocket Server (usually same as MQTT host)
WS_HOST=192.168.1.100
WS_PORT=8091

# Dashboard Configuration
DASHBOARD_PORT=8091
DASHBOARD_HOST=0.0.0.0

# NTFY Configuration
NTFY_PORT=8090
NTFY_URL=http://soundspy-ntfy:8090

# Alert Thresholds
FREQ_THRESHOLD_DBFS=-20
COOLDOWN_SECONDS=300

# Firmware Configuration
FIRMWARE_VERSION=0.8.3
NODE_PREFIX=node
DEFAULT_NODE_ID=node1
