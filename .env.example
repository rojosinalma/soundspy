# soundspy environment configuration
# Copy this file to .env and fill in your values

# WiFi Configuration (used by firmware build)
WIFI_SSID=your_wifi_ssid_here
WIFI_PASSWORD=your_wifi_password_here

# MQTT Broker — use your server's IP (ESP32 can't resolve hostnames across VLANs)
MQTT_HOST=soundspy-mosquitto
MQTT_PORT=1883

# Firmware MQTT/WS — must be IP addresses reachable from ESP32
FIRMWARE_MQTT_HOST=192.168.1.100
FIRMWARE_MQTT_PORT=1883
FIRMWARE_WS_HOST=192.168.1.100
FIRMWARE_WS_PORT=8091

# Dashboard
DASHBOARD_PORT=8091

# NTFY push notifications
NTFY_PORT=8090
NTFY_URL=http://soundspy-ntfy:8090

# Alert threshold
FREQ_THRESHOLD_DBFS=-20
COOLDOWN_SECONDS=300
