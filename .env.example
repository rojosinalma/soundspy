# soundspy environment configuration
# Copy this file to .env and fill in your values

# MQTT broker the dashboard connects to. Leave MQTT_USER empty for an anonymous broker.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=soundspy
MQTT_PASS=change_me
# Topic prefix the nodes publish under (<prefix>/<chip_id>/...)
MQTT_PREFIX=esp32

# Dashboard
DASHBOARD_PORT=8091

# --- Legacy firmware only (node_firmware/, built with ./scripts/build_firmware.sh legacy) ---
# The current firmware (firmware/) takes WiFi and MQTT settings from its captive portal instead.
WIFI_SSID=your_wifi_ssid_here
WIFI_PASSWORD=your_wifi_password_here
# Must be IP addresses reachable from the ESP32
FIRMWARE_MQTT_HOST=192.168.1.100
FIRMWARE_MQTT_PORT=1883
FIRMWARE_WS_HOST=192.168.1.100
FIRMWARE_WS_PORT=8091
