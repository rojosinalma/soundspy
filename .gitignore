# Local config overrides
docker-compose.override.yml
.env

# Claude Code local files (keep CLAUDE.md tracked, ignore everything else)
.claude/
!.claude/CLAUDE.md
CONTEXT.md

# Mosquitto runtime data
mosquitto/data/*
mosquitto/log/*
!mosquitto/data/.gitkeep
!mosquitto/log/.gitkeep

# ntfy runtime data
ntfy/cache/*
ntfy/etc/*
!ntfy/cache/.gitkeep
!ntfy/etc/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
venv/

# Compiled firmware binaries (all build outputs)
builds/

# Persistent state (node names, thresholds)
data/

# Rendered firmware (contains secrets, for manual Arduino IDE flashing)
node_firmware/*.rendered.ino

# Arduino CLI binary
bin/

# Local sync script
scripts/sync_watch.sh

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
