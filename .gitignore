# Local config overrides
docker-compose.override.yml
.env

# Claude Code local files (centralized in claude-configs, symlinked here)
.claude
CONTEXT.md

# ntfy runtime data
ntfy/cache/*
ntfy/etc/*
!ntfy/cache/.gitkeep
!ntfy/etc/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
venv/

# Compiled firmware binaries (all build outputs)
builds/

# Persistent state (node names, thresholds)
data/

# Rendered firmware (contains secrets, for manual Arduino IDE flashing)
node_firmware/*.rendered.ino

# Arduino CLI binary
bin/

# Local sync script
scripts/sync_watch.sh

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
