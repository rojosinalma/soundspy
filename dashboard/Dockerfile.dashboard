FROM python:3.12-slim

LABEL org.opencontainers.image.source="https://github.com/rojosinalma/soundspy" \
      org.opencontainers.image.description="soundspy dashboard: MQTT ingest, live audio relay, alerts and web UI for ESP32 sound-level nodes" \
      org.opencontainers.image.licenses="AGPL-3.0"

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY *.py ./
COPY templates/ templates/

ENV PYTHONUNBUFFERED=1

CMD ["python", "-u", "app.py"]
